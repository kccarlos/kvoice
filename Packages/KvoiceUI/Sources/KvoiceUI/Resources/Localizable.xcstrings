        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请为操作填写标题和指令。"
          }
        }
      }
    },
    "Give the configuration a name.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为该配置起个名称。"
          }
        }
      }
    },
    "Go to %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前往%@"
          }
        }
      }
    },
    "Go to the %@ step": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前往“%@”步骤"
          }
        }
      }
    },
    "Go to the %@ step to fix this": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前往“%@”步骤修复此问题"
          }
        }
      }
    },
    "Grant Microphone permission before running the level test.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行电平测试前请先授予麦克风权限。"
          }
        }
      }
    },
    "Grant Microphone permission in the Permissions section first.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在“权限”部分授予麦克风权限。"
          }
        }
      }
    },
    "Granted": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已授权"
          }
        }
      }
    },
    "Graphs update while a recording, a file transcription, or the performance test is running.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在录音、文件转写或性能测试运行期间图表会更新。"
          }
        }
      }
    },
    "Guides": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指南"
          }
        }
      }
    },
    "Guides, feedback, and acknowledgments.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指南、反馈与致谢。"
          }
        }
      }
    },
    "HTTPS is required for remote hosts. HTTP is permitted only for localhost, 127.0.0.1, or ::1. The key is stored separately from settings.json and is sent only in the provider's credential header.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程主机必须使用 HTTPS。仅 localhost、127.0.0.1 或 ::1 允许使用 HTTP。密钥与 settings.json 分开存储，只在服务商的凭据请求头中发送。"
          }
        }
      }
    },
    "HTTPS is required for remote hosts. The key is stored separately from settings.json and sent only in the provider's credential header.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程主机必须使用 HTTPS。密钥与 settings.json 分开存储，只在服务商的凭据请求头中发送。"
          }
        }
      }
    },
    "Held for %@ s": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已按住 %@ 秒"
          }
        }
      }
