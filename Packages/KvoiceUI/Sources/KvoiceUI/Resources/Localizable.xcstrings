        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加触发词"
          }
        }
      }
    },
    "Adding this term would need %lld tokens; the dictionary can use %lld of the model's %lld. Shorten or remove a term first.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Adding this term would need %1$lld tokens; the dictionary can use %2$lld of the model's %3$lld. Shorten or remove a term first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加此词条需要 %1$lld 个 token；词典可使用模型 %3$lld 个中的 %2$lld 个。请先缩短或移除一个词条。"
          }
        }
      }
    },
    "Adding this term would need about %lld tokens; the dictionary can use %lld of the model's %lld. Shorten or remove a term first.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Adding this term would need about %1$lld tokens; the dictionary can use %2$lld of the model's %3$lld. Shorten or remove a term first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加此词条约需 %1$lld 个 token；词典可使用模型 %3$lld 个中的 %2$lld 个。请先缩短或移除一个词条。"
          }
        }
      }
    },
    "Adds a connected device to the end of the list.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将一个已连接的设备添加到列表末尾。"
