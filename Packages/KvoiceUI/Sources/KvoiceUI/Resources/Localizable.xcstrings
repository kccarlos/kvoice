    "Sends one harmless manual Chat Completions test request. It is never sent automatically during dictation.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手动发送一次无害的 Chat Completions 测试请求。听写期间绝不会自动发送。"
          }
        }
      }
    },
    "Sends one harmless test request, then saves if it succeeds.": {
      "localizations": {
