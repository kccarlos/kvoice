    "AI skipped. Inserted the local transcript instead.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已跳过 AI。已改为插入本地转写文本。"
          }
        }
      }
    },
    "Accessibility permission is missing, so the result was copied to the clipboard.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少辅助功能权限，结果已复制到剪贴板。"
