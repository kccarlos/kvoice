            "value": "词典词条"
          }
        }
      }
    },
    "Dimmed options are not adjustable in this build yet.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灰显的选项在此版本中尚不可调整。"
          }
        }
      }
    },
    "Disables the global recording shortcut until another one is confirmed.": {
      "localizations": {
        "zh-Hans": {
