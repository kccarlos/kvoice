    "Using the loaded model's cap of %lld tokens, which is lower than the model's own limit.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在使用已加载模型的 %lld 个词元上限，它低于模型自身的限制。"
          }
        }
      }
    },
    "Verified and saved": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已验证并保存"
          }
        }
      }
    },
    "Verify & Save": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证并保存"
          }
        }
      }
    },
    "Verify & Save runs one short test request on this Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“验证并保存”会在这台 Mac 上运行一次简短的测试请求。"
          }
        }
      }
    },
    "Verify & Save sends one short test request to Private Cloud Compute.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“验证并保存”会向私密云计算发送一次简短的测试请求。"
          }
        }
      }
    },
    "Verify & Save sends one short test request to the endpoint.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“验证并保存”会向端点发送一次简短的测试请求。"
          }
        }
      }
    },
    "Verifying model — %lld of %lld files…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Verifying model — %1$lld of %2$lld files…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在验证模型 — %lld / %lld 个文件…"
          }
        }
      }
    },
    "Verifying model…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在验证模型…"
          }
        }
      }
    },
    "Verifying the package. Wait for verification to finish.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在验证模型包。请等待验证完成。"
          }
        }
      }
    },
    "Verifying — %lld of %lld files": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Verifying — %1$lld of %2$lld files"
          }
        },
