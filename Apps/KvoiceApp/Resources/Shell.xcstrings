        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 操作"
          }
        }
      }
    },
    "AI is on but no configuration is set, so dictation inserts the raw transcript. Add one in AI Actions.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 已开启但尚未设置配置，听写将插入原始转写文本。请在“AI 操作”中添加一个配置。"
          }
        }
      }
    },
    "About KVoice": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
