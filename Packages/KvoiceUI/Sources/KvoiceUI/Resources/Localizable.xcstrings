        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这台 Mac 上"
          }
        }
      }
    },
    "One emoji. Tip: ⌃⌘Space opens the emoji picker.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个表情符号。提示：⌃⌘空格键可打开表情符号选择器。"
