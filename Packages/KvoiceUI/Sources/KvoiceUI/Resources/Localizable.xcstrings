          }
        }
      }
    },
    "Click to set the default; double-click to edit; right-click for more. Built-in actions can be edited but not deleted. Reset anytime to restore the original text and trigger words.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
