    "Discards the active dictation without inserting anything, or dismisses the result shown on screen. The same as pressing Escape.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放弃当前听写而不插入任何内容，或关闭屏幕上显示的结果。等同于按 Escape 键。"
          }
