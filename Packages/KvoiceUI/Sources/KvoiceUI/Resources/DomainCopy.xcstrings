      }
    },
    "AI did not respond in time. Inserted the local transcript instead.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 未及时响应。已改为插入本地转写文本。"
          }
