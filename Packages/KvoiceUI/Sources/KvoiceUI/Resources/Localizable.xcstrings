          "stringUnit": {
            "state": "translated",
            "value": "在浏览器中打开。"
          }
        }
      }
    },
    "Opens the AI Actions page in the main window. Setup stays open and nothing is sent.": {
      "localizations": {
        "zh-Hans": {
