    "%@ also runs on this Mac: ready in seconds, with nothing large to download.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 也可在这台 Mac 上运行：几秒即可就绪，无需下载大文件。"
          }
        }
