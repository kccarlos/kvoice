        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发现的模型"
          }
        }
      }
    },
    "Dismiss": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        }
      }
    },
    "Dismiss the quick tour offer": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭快速导览提示"
          }
        }
      }
    },
    "Dock icon, Launch at Login, typed insertion, history saving, the recording options, automatic memory unloading, and the window layout go back to their defaults. Your AI configurations, API keys, shortcut, history entries, and model are kept.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "程序坞图标、登录时启动、键入插入、历史记录保存、录音选项、自动内存释放和窗口布局将恢复默认。你的 AI 配置、API 密钥、快捷键、历史记录条目和模型会保留。"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "Double-click a term to edit it. Press Delete to remove the selected terms.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连按两次词条进行编辑。按 Delete 键移除所选词条。"
          }
        }
      }
    },
    "Double-press to send (press Return after inserting)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连按两次发送（插入后按 Return）"
          }
        }
      }
    },
    "Double-tap to set as default. Actions menu offers Edit, Duplicate, and more.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连按两次设为默认。“操作”菜单提供编辑、复制等更多选项。"
          }
        }
      }
    },
    "Download": {
      "localizations": {
