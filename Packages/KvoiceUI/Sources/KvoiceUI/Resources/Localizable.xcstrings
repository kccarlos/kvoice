            "state": "translated",
            "value": "音频录音"
          }
        }
      }
    },
    "Audio is captured only while you dictate and is transcribed on this Mac by the local Whisper model. No recording is saved and nothing is uploaded.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
