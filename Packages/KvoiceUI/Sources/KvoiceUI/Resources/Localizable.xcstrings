            "state": "translated",
            "value": "打开%@。macOS 已拒绝的权限无法再次弹出请求。"
          }
        }
      }
    },
    "Opens Data & Privacy, where Save dictation history is turned on.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
