            "state": "translated",
            "value": "下载"
          }
        }
      }
    },
    "Download Model": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载模型"
          }
        }
      }
    },
    "Download paused with %@ kept. Resume to continue where it stopped.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载已暂停，已保留 %@。恢复后将从停止处继续。"
          }
        }
      }
    },
    "Download paused. Resume to continue.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载已暂停。恢复以继续。"
          }
        }
      }
    },
    "Download size": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载大小"
          }
        }
      }
    },
    "Download size and free space: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载大小与可用空间：%@"
          }
        }
      }
    },
    "Download the current model, or choose a folder that already holds a verified copy. A download keeps going while you finish the remaining screens.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载当前模型，或选择一个已包含已验证副本的文件夹。你完成剩余屏幕时下载会继续进行。"
          }
        }
      }
    },
    "Downloaded once, verified against the manifest bundled with this release, and used only on this Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只下载一次，对照此版本随附的清单验证，并只在这台 Mac 上使用。"
          }
        }
      }
    },
    "Downloaded once, verified against the manifest bundled with this release, and used only on this Mac. The first time it loads, it is optimized for your Mac, which can take a few minutes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只需下载一次，按此版本附带的清单校验，仅在这台 Mac 上使用。首次加载时会为这台 Mac 进行优化，可能需要几分钟。"
          }
        }
      }
    },
    "Downloading %@…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在下载 %@…"
          }
        }
      }
