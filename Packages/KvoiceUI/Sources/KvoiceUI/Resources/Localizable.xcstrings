      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在下载…"
          }
        }
      }
    },
    "Downloads and verifies the supported model. The download can be cancelled and resumed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载并验证受支持的模型。下载可以取消和恢复。"
          }
        }
      }
    },
    "Downloads the model from the repository named in the bundled manifest and verifies it. The download keeps going on later screens.": {
      "localizations": {
        "zh-Hans": {
