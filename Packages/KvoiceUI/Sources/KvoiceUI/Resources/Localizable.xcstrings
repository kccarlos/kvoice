      }
    },
    "Only from %@, the repository named in the bundled manifest.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅来自 %@，即随附清单中指定的仓库。"
          }
        }
      }
    },
    "Only from the repository named in the bundled manifest.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅来自随附清单中指定的仓库。"
          }
        }
      }
    },
    "Only one action is active at a time. It auto-applies after each transcription while AI Actions is on. Current: %@ %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Only one action is active at a time. It auto-applies after each transcription while AI Actions is on. Current: %1$@ %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次只有一个操作处于活跃状态。AI 操作开启时，它会在每次转写后自动应用。当前：%@ %@。"
          }
        }
      }
    },
    "Only the first %lld terms are sent; the rest are kept for another model.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅发送前 %lld 个词条；其余词条会为其他模型保留。"
          }
        }
      }
    },
    "Only under critical system memory pressure and only while idle; the next dictation reloads the model.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在系统内存压力严重且处于空闲时才会执行；下一次听写会重新加载模型。"
          }
        }
      }
    },
