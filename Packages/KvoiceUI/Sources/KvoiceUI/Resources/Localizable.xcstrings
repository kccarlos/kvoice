          }
        }
      }
    },
    "Optional API key": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选的 API 密钥"
          }
        }
      }
    },
    "Optional polish and translation, and the endpoint that runs them. Off by default.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选的润色与翻译，以及运行它们的端点。默认关闭。"
          }
        }
      }
    },
    "Optional. Name, role, industry, tech stack, communication style, languages.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选。姓名、职位、行业、技术栈、沟通风格、语言。"
          }
        }
      }
    },
    "Over the current model's budget: the model only sees the first %lld tokens. Remove terms until the counter is under %lld.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Over the current model's budget: the model only sees the first %1$lld tokens. Remove terms until the counter is under %2$lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超出当前模型的预算：模型只能看到前 %1$lld 个 token。请移除词条直到计数低于 %2$lld。"
          }
        }
      }
    },
    "Overlapping dictation paused: CPU-only compute": {
