        }
      }
    },
    "AI authentication failed. Inserted the local transcript instead.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 身份验证失败。已改为插入本地转写文本。"
