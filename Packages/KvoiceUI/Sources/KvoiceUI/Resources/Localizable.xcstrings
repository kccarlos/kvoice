          }
        }
      }
    },
    "Stopping the download…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在停止下载…"
          }
        }
      }
    },
    "Stopping…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在停止…"
          }
        }
      }
    },
    "Stops the download. Downloaded bytes are kept so it can be resumed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止下载。已下载的数据会保留，以便恢复。"
          }
        }
      }
    },
    "Stops using the external folder without deleting it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止使用外部文件夹，但不删除它。"
          }
        }
      }
    },
    "Stored": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已存储"
          }
        }
      }
    },
    "Stores the configuration without sending a test request.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储配置，不发送测试请求。"
          }
        }
      }
    },
    "Streaming": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "流式"
          }
        }
      }
    },
    "Streaming or Batch": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "流式或批处理"
          }
        }
      }
    },
    "Succeeded": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "成功"
          }
        }
      }
    },
    "Switch between your saved actions with ⌘1–⌘0, in the order they are saved. The shortcut works while a dictation is in progress, and on this page when the KVoice window is focused.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 ⌘1–⌘0 按保存顺序在已保存的操作之间切换。该快捷键在听写进行中有效，在 KVoice 窗口获得焦点时也在此页面有效。"
          }
        }
      }
    },
    "System Default": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统默认"
          }
        }
      }
    },
    "System Default follows System Settings. Custom Device pins one microphone. Prioritized uses the first connected device from your list.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“系统默认”跟随系统设置。“自定义设备”固定使用一个麦克风。“优先级列表”使用列表中第一个已连接的设备。"
          }
        }
      }
    },
    "System Settings could not be opened automatically. Go to %@ and enable KVoice.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法自动打开“系统设置”。请前往%@并启用 KVoice。"
          }
        }
      }
    },
    "System Settings › Privacy & Security › Accessibility": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统设置 › 隐私与安全性 › 辅助功能"
          }
        }
      }
    },
    "System Settings › Privacy & Security › Microphone": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统设置 › 隐私与安全性 › 麦克风"
          }
        }
      }
    },
    "System-managed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统管理"
          }
        }
      }
    },
    "Take the Quick Tour": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看快速导览"
          }
        }
      }
    },
    "Target": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标"
          }
        }
      }
    },
    "Target language": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标语言"
          }
        }
      }
    },
    "Teach KVoice names and jargon in Dictionary, turn on polish or translation in AI Actions, switch speech models, or choose a different device in Microphone — all in KVoice's main window.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在词典中教 KVoice 识别专有名词和术语，在 AI 操作中开启润色或翻译，切换语音模型，或在麦克风中更换设备——这些都在 KVoice 的主窗口中完成。"
          }
        }
      }
    },
    "Term": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "词条"
          }
        }
      }
    },
    "Terms": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "词条"
          }
        }
      }
    },
    "Terms sent as hints": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "作为提示发送的词条"
          }
        }
      }
    },
    "Test Active Configuration": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试当前配置"
          }
        }
      }
    },
    "Test Configuration": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试配置"
          }
        }
      }
    },
    "Test Prompt": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试提示词"
          }
        }
      }
    },
    "Testing…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在测试…"
          }
        }
      }
    },
    "That backup could not be read. It may have been moved or deleted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取该备份。它可能已被移动或删除。"
          }
        }
      }
    },
    "The <resource> in https://<resource>.openai.azure.com": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "https://<resource>.openai.azure.com 中的 <resource>"
          }
        }
      }
    },
    "The checked transcripts and their stored recordings are removed. Everything else stays. This cannot be undone.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已勾选的转写及其存储的录音会被移除。其他内容保留。此操作无法撤销。"
          }
        }
      }
    },
    "The chosen device is not connected; the system default is used until it returns.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选设备未连接；在它重新连接之前使用系统默认设备。"
          }
        }
      }
    },
    "The default action runs after each transcription. Click to set the default; double-click to edit; right-click for more.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认操作在每次转写后运行。点按设为默认；连按两次编辑；右键点按查看更多。"
          }
        }
      }
    },
    "The dictionary is written as plain text, one term per line.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "词典以纯文本写出，每行一个词条。"
          }
        }
      }
    },
    "The dictionary may use %lld of %@; the rest is kept in reserve. %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The dictionary may use %1$lld of %2$@; the rest is kept in reserve. %3$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "词典可使用%2$@中的 %1$lld 个；其余保留。%3$@"
          }
        }
      }
    },
    "The downloaded package is removed from disk. Other models, your settings, history, and shortcut are kept.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已下载的模型包会从磁盘移除。其他模型、你的设置、历史记录和快捷键会保留。"
          }
        }
      }
    },
    "The endpoint URL is not usable.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端点 URL 不可用。"
          }
        }
      }
    },
    "The endpoint answered, but not with the expected reply. Check the model name.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端点有响应，但不是预期的回复。请检查模型名称。"
          }
        }
      }
    },
    "The endpoint could not be reached. Check the URL and your connection.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接端点。请检查 URL 和网络连接。"
          }
        }
      }
    },
    "The endpoint is rate-limited%@. Try again shortly.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端点已限流%@。请稍后重试。"
          }
        }
      }
    },
    "The endpoint reported no models.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端点未报告任何模型。"
          }
        }
      }
    },
    "The endpoint returned an error%@. Check the model name and URL path.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端点返回了错误%@。请检查模型名称和 URL 路径。"
          }
        }
      }
    },
    "The export could not be written.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法写入导出文件。"
          }
        }
      }
    },
    "The file contains no terms.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件中没有词条。"
          }
        }
      }
    },
    "The file could not be written.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法写入文件。"
          }
        }
      }
    },
    "The first connected device in your list.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "列表中第一个已连接的设备。"
          }
        }
      }
    },
    "The first run after a load includes Core ML warm-up; run it again for the steady figure.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加载后的首次运行包含 Core ML 预热；再运行一次可得到稳定数值。"
          }
        }
      }
    },
    "The first-run guide, for walking through the model, permissions, and shortcut again. It deletes nothing.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次运行向导，用于再次完成模型、权限和快捷键的设置。不删除任何内容。"
          }
        }
      }
    },
    "The folder was moved, deleted, or its permission expired. Exports are skipped until you choose it again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件夹已被移动、删除或权限已过期。在你重新选择之前会跳过导出。"
          }
        }
      }
    },
    "The global key that starts and stops dictation. KVoice listens for this one key and nothing else.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于开始和停止听写的全局按键。KVoice 只监听这一个按键，别无其他。"
          }
        }
      }
    },
    "The installed model failed verification. %@ Retry to download it again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已安装的模型未通过验证。%@ 请重试以重新下载。"
          }
        }
      }
    },
    "The key that starts a dictation. Push-to-Talk is the safe default.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始听写的按键。“按住说话”是安全的默认选项。"
          }
        }
      }
    },
    "The keys and buttons that start, stop, and cancel a dictation.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于开始、停止和取消听写的按键和按钮。"
          }
        }
      }
    },
    "The language of KVoice's own windows and menus. Speech recognition and translation languages are set in Speech Models and AI Actions.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "KVoice 自身窗口和菜单的语言。语音识别和翻译的语言在“语音模型”和“AI 操作”中设置。"
          }
        }
      }
    },
    "The level test keeps no audio; the meter shows the peak once the test finishes. It uses the device chosen above.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电平测试不保留任何音频；测试结束后仪表显示峰值。它使用上方选择的设备。"
          }
        }
      }
    },
    "The link could not be opened. Copy it instead: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开链接。请改为复制：%@"
          }
        }
      }
    },
    "The local speech models that transcribe your voice on this Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这台 Mac 上转写你语音的本地语音模型。"
          }
        }
      }
    },
    "The managed package is removed from disk. Dictation is Not Ready until a model is downloaded or chosen again. Your settings, history, and shortcut are kept.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "托管的模型包会从磁盘移除。在重新下载或选择模型之前，听写处于“未就绪”状态。你的设置、历史记录和快捷键会保留。"
          }
        }
      }
    },
    "The menu bar": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单栏"
          }
        }
      }
    },
    "The microphone is used only while you dictate. Audio is transcribed on this Mac, and the short level test below is not saved.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风只在你听写时使用。音频在这台 Mac 上转写，下方的简短电平测试不会保存。"
          }
        }
      }
    },
    "The microphone test could not be completed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法完成麦克风测试。"
          }
        }
      }
    },
    "The model is transcribing. Wait for the current dictation to finish.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型正在转写。请等待当前听写完成。"
          }
        }
      }
    },
    "The package behind the current model, and the actions that manage it. Verified against the manifest bundled with this release before it is loaded.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前模型背后的模型包，以及管理它的操作。加载前会对照此版本随附的清单进行验证。"
          }
        }
      }
    },
    "The recording could not be opened.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开录音。"
          }
        }
      }
    },
    "The recording produced no transcript.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音未生成转写文本。"
          }
        }
      }
    },
    "The recording was transcribed again with the current model. Replacing keeps the recording, timing, and AI result; only the original transcript changes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音已用当前模型重新转写。替换会保留录音、时间信息和 AI 结果；只有原始转写会改变。"
          }
        }
      }
    },
    "The request did not fit the on-device model's context window.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求超出了本机模型的上下文窗口。"
          }
        }
      }
    },
    "The request failed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求失败。"
          }
        }
      }
    },
    "The request failed. Check the AI configuration.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求失败。请检查 AI 配置。"
          }
        }
      }
    },
    "The setup guide will open again from the first screen. Your model, history, shortcut, and other settings are kept.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置向导会从第一屏重新打开。你的模型、历史记录、快捷键和其他设置会保留。"
          }
        }
      }
    },
    "The shortcut is not active until it is confirmed. Right Option on its own is offered in the recorder.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快捷键在确认之前不会生效。录制器中可选择单独的右 Option 键。"
          }
        }
      }
    },
    "The silent pass run right after the model loaded, so the first dictation is not slower than the second.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型加载后立即运行的静默预热，使第一次听写不比第二次慢。"
          }
        }
      }
    },
    "The speech model catalog is not connected in this build.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本未连接语音模型目录。"
          }
        }
      }
    },
    "The speech runtime is not connected in this build.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本未连接语音运行时。"
          }
        }
      }
    },
    "The test was cancelled.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试已取消。"
          }
        }
      }
    },
    "The token budget appears once a speech model is set up.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置好语音模型后会显示 token 预算。"
          }
        }
      }
    },
    "The transcript is supplied separately, wrapped in <TRANSCRIPT> tags. Instruct the model to treat it as data, not instructions.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转写文本会单独提供，并包裹在 <TRANSCRIPT> 标签中。请指示模型把它当作数据而非指令。"
          }
        }
      }
    },
    "There is no account, telemetry, or background recording.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有账户、遥测或后台录音。"
          }
        }
      }
    },
    "There may not be enough free space for the download. Free up space or choose an existing model folder.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可用空间可能不足以完成下载。请释放空间或选择现有的模型文件夹。"
          }
        }
      }
