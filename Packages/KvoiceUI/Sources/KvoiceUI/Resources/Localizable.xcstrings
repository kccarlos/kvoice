      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 基础 URL"
          }
        }
      }
    },
    "AI did not respond. The raw transcript was used instead.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 未响应。已改用原始转写文本。"
          }
        }
      }
    },
    "AI is optional and off by default. When enabled, the default action from Settings › AI Actions runs after each transcription; only the local transcript is sent to your configured endpoint.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 为可选功能，默认关闭。开启后，“设置 › AI 操作”中的默认操作会在每次转写后运行；只有本地转写文本会发送到你配置的端点。"
          }
        }
      }
    },
    "AI model ID": {
      "localizations": {
        "zh-Hans": {
